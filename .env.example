# TROP — environment. Copy to .env. EVERY key is optional: without keys TROP runs in offline mode
# (cached VLM/LLM/enrichment outputs, recorded demo streams). Never commit .env.

# ---- mode
TROP_MODE=offline                 # offline | live | mock (API serves the fictional design universe)
# TROP_REPLAY=false               # true: every SSE stream serves the recorded demo run

# ---- storage (defaults match deploy/compose.yml; dev DB on the home PC is 55432)
# DATABASE_URL=postgresql://trop:trop_dev@127.0.0.1:55433/trop
# REDIS_URL=redis://127.0.0.1:56379/0
# DATA_DIR=./data

# ---- LLM / VLM (optional; live analysis of new screenshots, videos, White Rabbit, notices)
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey (AI Studio key, not Vertex). Default LLM.
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_ASR_MODEL=gemini-3.5-transcribe
OPENROUTER_API_KEY=               # https://openrouter.ai/keys — ad-screenshot VLM (qwen/qwen3.6-35b-a3b) + LLM fallback
# ANTHROPIC_API_KEY=              # optional drop-in LLM
# LLM_BUDGET_USD=30               # hard stop for paid model calls per process lifetime

# ---- sources (optional; Hunter / enrichment / White Rabbit tools)
META_ACCESS_TOKEN=                # Meta Ad Library API (ads_archive), needs identity verification: https://www.facebook.com/ads/library/api
META_APP_ID=
META_APP_SECRET=
URLSCAN_API_KEY=                  # https://urlscan.io/user/profile/ (free tier, non-commercial)
IPINFO_TOKEN=                     # https://ipinfo.io/account/token
CERTSPOTTER_API_KEY=              # https://sslmate.com/certspotter/api (optional; crt.sh works without)
GOOGLE_CLOUD_PROJECT=             # BigQuery Google Ads Transparency (needs `gcloud auth application-default login`)
WIKIMEDIA_UA=                     # "name/version (contact: <address>)" — only for rebuilding the face gallery

# ---- deploy (integrator only)
# COOLIFY_URL=
# COOLIFY_API_TOKEN=
# TROP_BIND=127.0.0.1             # bind address for published ports (home PC: 10.8.0.3)

{
  "manifest_version": 3,
  "name": "TROP: Sprawdź reklamę",
  "version": "0.1.0",
  "description": "Oznacza reklamy pasujące do znanych kampanii oszustw. Wysyła tylko anonimowy odcisk reklamy.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://trop.b.solvro.pl/*",
    "http://127.0.0.1:18000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://trop.b.solvro.pl/demo/*",
        "file:///*/feed*.html"
      ],
      "js": ["phash.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TROP: Sprawdź reklamę" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
